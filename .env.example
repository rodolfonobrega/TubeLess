# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_DB=tubeless
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by local/manual backend runs. Docker Compose builds its own internal
# database URL with the postgres service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/tubeless
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/tubeless

# =============================================================================
# LLM
# O prefixo do modelo determina o provider — configure só a key correspondente
#
# Exemplos:
#   gpt-4o-mini                              → OPENAI_API_KEY
#   anthropic/claude-3-5-sonnet-20241022     → ANTHROPIC_API_KEY
#   groq/llama-3.3-70b-versatile             → GROQ_API_KEY
#   gemini/gemini-1.5-pro                    → GEMINI_API_KEY
#   openrouter/anthropic/claude-3-5-sonnet   → OPENROUTER_API_KEY
# =============================================================================
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Modelos por função (opcional — usa DEFAULT_MODEL se não definido)
# TRIAGE_MODEL=groq/llama-3.3-70b-versatile   # query expansion, ranking, query rewriting
# SUMMARIZATION_MODEL=gpt-4o-mini              # map-reduce summarization
# ANSWER_MODEL=gpt-4o                          # resposta final do RAG

# Reasoning: low | medium | high (só para modelos que suportam, ex: claude-3-7, o1, deepseek-r1)
# REASONING_EFFORT=low

# Comments & Search behavior
MAX_COMMENTS=100            # top comentários por vídeo (ordenados por likes)
PRE_SELECTED_COUNT=3        # videos pré-selecionados pelo LLM após ranking
SEARCH_RESULTS_PER_TERM=8   # resultados buscados por termo de pesquisa
SEARCH_TERMS_PER_LANGUAGE=3 # termos gerados por idioma (PT + EN)

# Provider API Keys — configure apenas a do provider escolhido
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Proxy customizado (opcional)
# OPENAI_API_BASE=https://seu-proxy.com/v1

# =============================================================================
# APPLICATION
# =============================================================================
TUBELESS_RUNTIME=local
SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Host-facing URLs for local/manual runs. Docker Compose supplies its own
# INTERNAL_BACKEND_URL for the server-side proxy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# yt-dlp cookie configuration (opcional)
# Se estiver rodando no Docker ou headless:
# YTDLP_COOKIES_FILE=cookies.txt
# Se quiser extrair do browser local (só funciona rodando backend nativamente):
# YTDLP_COOKIES_BROWSER=chrome
